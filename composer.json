{
    "name": "supertext/akeneo-supertext-translation",
    "description": "Supertext AI translation for Akeneo PIM: translate products and product models into your other locales.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["akeneo", "akeneo-pim", "pim", "bundle", "translation", "supertext", "machine translation", "localization"],
    "authors": [{ "name": "Supertext AG", "email": "support@supertext.com", "homepage": "https://www.supertext.com" }],
    "homepage": "https://github.com/Supertext/Akeneo-Supertext-Translation",
    "require": {
        "php": "~8.3.0",
        "akeneo/pim-community-dev": "^2026.3"
    },
    "autoload": {
        "psr-4": { "Supertext\\AkeneoTranslationBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Supertext\\AkeneoTranslationBundle\\Tests\\": "tests/" }
    },
    "archive": { "exclude": ["/demo", "/tests", "/docs"] }
}
