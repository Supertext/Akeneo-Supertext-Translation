# Supertext Translation for Akeneo PIM: demo variables.
# On Railway these are service variables; locally pass them with `docker run --env-file`.
# Never commit real values.

# --- Supertext ---------------------------------------------------------------
# No Supertext account yet? Create one at supertext.com:
#   https://www.supertext.com/person/en/account/signin
# Generate your API key at supertext.com → Integrations → API (requires the Admin role):
#   https://www.supertext.com/en/integrations/api
# Optional: without it, an administrator enters the key under System → Supertext.
SUPERTEXT_API_KEY=
# Only for tests against a stand-in API (leave empty for the live API).
SUPERTEXT_API_URL=

# --- Demo accounts (created on every start if missing, never changed) ----------
# Log in with the email address. Passwords: 8 to 4096 characters (Akeneo's rule).
# Role "Administrator", all user groups.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Role "Catalog manager": edits and translates products and product models in every locale.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# --- Database (MySQL 8.4) ----------------------------------------------------
# Railway: reference the MySQL service, e.g. MYSQL_URL=${{MySQL.MYSQL_URL}}
MYSQL_URL=
# The demo uses its own database on that server and creates it if needed.
AKENEO_DB_NAME=akeneo

# --- Elasticsearch 8 (Akeneo's product search index) ---------------------------
# host:port, Railway: ${{Elasticsearch.RAILWAY_PRIVATE_DOMAIN}}:9200
APP_INDEX_HOSTS=elasticsearch.railway.internal:9200

# --- Secret (any long random string; keep it stable) ---------------------------
APP_SECRET=

# Public address, if it isn't Railway's RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
